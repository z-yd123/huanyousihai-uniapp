<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hys.mapper.HysRouteDayMapper">

    <resultMap type="HysRouteDay" id="HysRouteDayResult">
        <id     property="dayId"       column="day_id"/>
        <result property="productId"   column="product_id"/>
        <result property="dayNo"       column="day_no"/>
        <result property="title"       column="title"/>
        <result property="content"     column="content"/>
        <result property="images"      column="images"/>
        <result property="gatherTime"  column="gather_time"/>
        <result property="gatherPlace" column="gather_place"/>
    </resultMap>

    <select id="selectDaysByProductId" parameterType="Long" resultMap="HysRouteDayResult">
        select day_id, product_id, day_no, title, content, images, gather_time, gather_place
        from hys_route_day
        where product_id = #{productId}
        order by day_no asc
    </select>

    <delete id="deleteDaysByProductId" parameterType="Long">
        delete from hys_route_day where product_id = #{productId}
    </delete>

    <insert id="batchInsertDays">
        insert into hys_route_day (product_id, day_no, title, content, images, gather_time, gather_place) values
        <foreach collection="list" item="item" separator=",">
            (#{item.productId}, #{item.dayNo}, #{item.title}, #{item.content}, #{item.images},
             #{item.gatherTime}, #{item.gatherPlace})
        </foreach>
    </insert>
</mapper>
